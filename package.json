{
  "name": "caderninho",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @caderninho/api && npm run build -w @caderninho/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @caderninho/api",
    "db:migrate": "npm run db:migrate -w @caderninho/api",
    "setup": "node scripts/setup-env.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.20.0"
  }
}
